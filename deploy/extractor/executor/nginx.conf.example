# Private network listener only; add deployment-specific private app allowlist/firewall.
server {
    listen PRIVATE_INTERFACE_IP:443 ssl;
    server_name extractor.internal.example;
    ssl_certificate /etc/private-extractor/tls/fullchain.pem;
    ssl_certificate_key /etc/private-extractor/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/extractor-error.log crit;
    client_max_body_size 10m;
    client_body_timeout 5s;
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_ignore_client_abort off;
        proxy_read_timeout 30s;
        proxy_send_timeout 5s;
    }
}
