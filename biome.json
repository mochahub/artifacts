{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!fixtures",
      "!**/test/fixtures",
      "!packages/kit/src/templates",
      "!skill/references/kit.md",
      "!spikes",
      "!docs",
      "!**/dist",
      "!**/drizzle",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
