{
  "name": "@artifacts/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "size": "size-limit",
    "board-size": "bun scripts/board-size.ts"
  },
  "size-limit": [
    {
      "name": "initial route",
      "path": "dist/assets/index-*.js",
      "limit": "80 KB",
      "gzip": true
    },
    {
      "name": "editor (with the sync provider and Yjs)",
      "path": [
        "dist/assets/editor-*.js",
        "dist/assets/provider-*.js"
      ],
      "limit": "120 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@artifacts/doc": "workspace:*",
    "@artifacts/schema": "workspace:*",
    "@preact/signals": "^2.11.4",
    "@simplewebauthn/browser": "14.0.0",
    "lib0": "0.2.119",
    "lucide-preact": "^1.65.0",
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2",
    "prosemirror-commands": "1.7.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "size-limit": "^14.3.0",
    "vite": "^8.3.5"
  }
}
