{
  "name": "@artifacts/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --external sharp --outfile=dist/server.js && cp ../../packages/sandbox/src/child.js ../../packages/sandbox/src/prelude.js dist/",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@artifacts/doc": "workspace:*",
    "@artifacts/kit": "workspace:*",
    "@artifacts/sandbox": "workspace:*",
    "@artifacts/schema": "workspace:*",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^4.0.0",
    "sharp": "0.35.5",
    "tldts": "^7.4.19",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
