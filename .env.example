# Every variable the server reads (apps/server/src/env.ts, contract in docs/implementation/09-deploy.md).
# `bun run dev` supplies these itself; copy to .env only to run the server by hand.
# The values below are for local development only. Never use them anywhere reachable: generate real secrets
# (`openssl rand -hex 32`), or let `artifacts setup` do it. A Docker deployment keeps its own .env (deploy/compose).

# --- Required ---
# Postgres connection string.
DATABASE_URL=postgres://artifacts:artifacts@127.0.0.1:5432/artifacts
# S3 API of the bucket, as the server reaches it. A plain origin: no path.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=auto
# The server creates the bucket at boot if it can and it is missing.
S3_BUCKET=artifacts-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
# Where people open the viewer, and what copied links use.
PUBLIC_URL=http://localhost:8080
# First-run claim token for `artifacts setup`. 32 characters or more.
SETUP_TOKEN=dev-setup-token-dev-setup-token-dev
# Signs content tokens; rotating it signs everyone out. 32 characters or more.
SESSION_SECRET=dev-session-secret-dev-session-secret-dev-session-secret-dev-ses
# Bearer token for the operators' port (INTERNAL_PORT), which must stay unpublished. 32 characters or more.
OPS_SECRET=dev-ops-secret-dev-ops-secret-dev-ops-secret-dev-ops-secret-dev-o

# --- Needed for Live previews ---
# The origin Live previews are served from. Its own host, on a different registrable domain from the viewer's.
# Without it the server still starts, with Live previews off.
CONTENT_URL=http://127.0.0.1:8081

# --- Optional ---
# Extra viewer origins, comma-separated (here: the Vite dev server).
MORE_URLS=http://localhost:5173
# The bucket's address in presigned URLs, when browsers reach it differently from the server (a reverse proxy).
# Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:8333
# "false" for virtual-hosted-style buckets (Railway). Default "true".
# S3_FORCE_PATH_STYLE=true
# Ports inside the container or on this machine. Defaults shown: viewer, Live previews, operators.
# PORT=8080
# CONTENT_PORT=8081
# INTERNAL_PORT=8082
# debug, info, warn or error. Default info.
# LOG_LEVEL=info
# owner/repo checked for the "new version available" notice in Settings. "none" turns it off.
# GITHUB_RELEASES_REPO=mochahub/artifacts
